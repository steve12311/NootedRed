static constexpr unsigned major=25;
static constexpr unsigned BaseFunctions=std::size(D::ResolverFunctions),GuardFunctions=std::size(G::ResolverFunctions);
static UserCacheResolver::Function merged[BaseFunctions+GuardFunctions];
static std::vector<UserCacheResolver::Reference> refs[GuardFunctions];
static std::map<uint64_t,int> maxima;
static std::set<unsigned> failWrites;
static bool failAllocation=false,noMap=false;
static int originalResult=0,regionMode=0;
static unsigned allocations=0,deallocations=0,payloadWrites=0;
static const char* processName="Other";
static kern_return_t vm_allocate(vm_map_t,uint64_t* a,unsigned size,int){
 allocations++;if(failAllocation)return 3;assert(size==4096);*a=0x40000000;
 assert(!blocks.contains(*a));blocks[*a].resize(4096);protections[*a]=3;maxima[*a]=7;return 0;
}
static kern_return_t vm_deallocate(vm_map_t,uint64_t a,unsigned){deallocations++;assert(blocks.erase(a)==1);protections.erase(a);maxima.erase(a);return 0;}
static std::set<uint64_t> touchedPages;
static std::vector<uint64_t> writeOrder;
static kern_return_t vm_protect(vm_map_t,uint64_t a,unsigned,int maximum,int flags){
 protects++;if(protects==failedProtect||failedProtectCalls.contains(protects))return 42;
 assert(protections.contains(a));touchedPages.insert(a);int value=flags&7;
 if(maximum){maxima[a]=value;protections[a]&=value;}else {protections[a]=value;maxima[a]|=value;}
 return 0;
}
static int proc_pid(proc_t p){return int(reinterpret_cast<uintptr_t>(p));}
static void proc_name(int,char* name,int size){snprintf(name,size,"%s",processName);}
