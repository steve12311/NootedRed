struct NRed {static NRed& singleton(){static NRed n;return n;}void setProp32(const char* k,unsigned v){properties[k]=v;}
 unsigned getDeviceID(){return device; }static unsigned device;};unsigned NRed::device=0x1638;
struct Version{unsigned major(){return majorValue;}unsigned minor(){return minorValue;}static unsigned majorValue,minorValue;};unsigned Version::majorValue=25;unsigned Version::minorValue=6;
const PenguinWizardry::KernelVersion& currentKernelVersion(){static std::optional<PenguinWizardry::KernelVersion> current;return current.emplace(Version::majorValue,Version::minorValue);}
static bool flag=true,fvrcEnabled=true;static bool checkKernelArgument(const char* s){
 assert(strcmp(s,"-NRedVideoFix")==0||strcmp(s,"-NRedNoFVRC")==0);
 if(strcmp(s,"-NRedNoFVRC")==0)return !fvrcEnabled;
 return flag;}
namespace VCN { static bool active=true; bool allocated(){return active;} }
#define IONew(T,N) (new T[N])
#define IODelete(P,T,N) delete[] P
constexpr int KERN_RESOURCE_SHORTAGE=3;
struct KernelPatcher{
 static constexpr int KernelID=0;int solves=0,routes=0;bool missing=false,routeOK=true;
 static inline UInt8 destroyCode[16]{};
 static void destroy(vm_map_t){}
 struct RouteRequest{const char* symbol;uint64_t from=0,*org;template<typename T,typename O>RouteRequest(const char* s,T,O& o):symbol(s),org(reinterpret_cast<uint64_t*>(&o)) {}};
 uint64_t solveSymbol(int,const char* s){solves++;return missing?0:(strcmp(s,"_vm_map_destroy")==0?reinterpret_cast<uint64_t>(destroyCode):1);}void clearError(){}
 bool routeMultipleLong(int,RouteRequest* request,int count){assert(count==1);routes++;if(routeOK&&strcmp(request->symbol,"_vm_map_destroy")==0)*request->org=reinterpret_cast<uint64_t>(destroy);return routeOK;}
};namespace UserVideoDecode{void init(KernelPatcher&);}
static task_t current_task(){return reinterpret_cast<void*>(1);}
static void* current_thread(){static thread_local char identity;return &identity;}
