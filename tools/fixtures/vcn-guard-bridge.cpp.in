INIT
static int original(proc_t,SharedRegionCheckArgs*,int* value){*value=123;return originalResult;}
static vm_map_t map(task_t){return noMap?nullptr:reinterpret_cast<void*>(2);}
static kern_return_t query(vm_map_t,uint64_t* a,uint64_t* size,unsigned* depth,int* p,unsigned* count){
 if(regionMode==1)return 42;assert(*count==VM_REGION_SUBMAP_SHORT_INFO_COUNT_64);
 auto* info=reinterpret_cast<vm_region_submap_short_info_data_64_t*>(p);*size=4096;
 info->is_submap=*depth==0;info->protection=*depth==0?1:(protections.contains(*a)?protections.at(*a):1);
 info->max_protection=*depth==0?5:(maxima.contains(*a)?maxima.at(*a):5);
 info->object_id=0x1234;info->share_mode=5;info->shadow_depth=0;
 if(regionMode==2)*a+=4096;if(regionMode==3)*count=1;if(regionMode==4)*size=4095;
 return 0;
}
static int copyout(const void* p,uint64_t a,size_t n){
 if(a==0x40000000)payloadWrites++;
 else writeOrder.push_back(a);
 if(failWrites.contains(writes+1)){writes++;put(a,p,std::min(n,size_t(2)));return 1;}
 return writer(p,a,n);
}
static UserVideoDecodeResolver::Plan nativePlan;
static UserVideoGuardResolver::Plan safetyPlan;
static void setup(unsigned id=0x1638){
 for(unsigned i=0;i<BaseFunctions;i++)merged[i]=D::ResolverFunctions[i];
 for(unsigned i=0;i<GuardFunctions;i++){
  auto fn=G::ResolverFunctions[i];refs[i].assign(fn.originalRefs,fn.originalRefs+fn.originalCount);
  for(auto& ref:refs[i]){assert(ref.image==0);ref.image=2;}
  assert(fn.image==0);fn.image=2;fn.originalRefs=fn.patchedRefs=refs[i].data();merged[BaseFunctions+i]=fn;
 }
 cache(D::ResolverImages,merged,true,G::SectionTargets,std::size(G::SectionTargets));
 // 模拟所有函数跨页和数据节独立迁移；代码匹配仍使用各自来源版本的完整证据。
 NRed::device=id;Version::majorValue=major;devicePatches=D::findDevice(id);sequoia=major==24;
 fairPlayDriverOnly=true;maxima.clear();failWrites.clear();failAllocation=noMap=false;originalResult=regionMode=0;
 allocations=deallocations=payloadWrites=0;touchedPages.clear();writeOrder.clear();published={};seenStages=appliedCount=errorCount=0;
 failNewAt=newCalls=0;
 clientEntitlement=nullptr;processName="Other";entitlementQueries=0;trueEntitlement.releases=falseEntitlement.releases=0;
 originalCheck=reinterpret_cast<uint64_t>(original);getTaskMap=map;queryRegion=query;readUser=reader;writeUser=copyout;
 if(!guardLock)guardLock=IOLockAlloc();
 nativePlan={};safetyPlan={};UserSharedCache::Input input{reader,{}};
 assert(UserVideoDecodeResolver::resolve(input,base,devicePatches,nativePlan,sequoia));
 assert(UserVideoGuardResolver::resolve(input,base,major,safetyPlan));
 pages(nativePlan.patches,D::PatchCount);pages(safetyPlan.patches,safetyPlan.count);
 for(auto[a,p]:protections)maxima[a]=p;
}
static void call(){SharedRegionCheckArgs args{0x1000};int value=0;
 assert(wrappedSharedRegionCheck(reinterpret_cast<void*>(217),&args,&value)==originalResult&&value==123);
}
static void unchanged(const std::map<uint64_t,std::vector<uint8_t>>& before){assert(blocks==before);rx();for(auto[a,p]:protections)assert(maxima.at(a)==5);}
static void noApplied(){assert(!properties.contains("NRedVCNUserApplied")&&!properties.contains("NRedVCNEncodeGuardRevision"));}
static unsigned cases;
static void accepted(bool fair){
 call();assert(properties.at("NRedVCNEncodeGuardRevision")==1&&properties.at("NRedVCNDecodeGuardRevision")==1);
 assert(properties.at("NRedVCNVPFPath")==1&&properties.contains("NRedVCNVPFPlannerEnabled"));
 assert(properties.contains("NRedVCNVPFPlanState")&&properties.contains("NRedVCNVPFLedgerState"));
 assert(writes==(fair?18:D::PatchCount)+safetyPlan.count+1);assert(allocations==1&&deallocations==0&&payloadWrites==1);rx();
 assert(writeOrder.size()==(fair?18U:unsigned(D::PatchCount))+safetyPlan.count);
 for(unsigned i=0;i<safetyPlan.count;i++)assert(writeOrder[i]==base+safetyPlan.patches[i].offset);
 for(auto[a,p]:protections)assert(maxima.at(a)==5);
 for(unsigned i=0;i<D::PatchCount;i++){
  const auto& p=nativePlan.patches[i];uint8_t bytes[D::MaxPatchSize];assert(reader(base+p.offset,bytes,p.size)==0);
  bool selected=!fair || ((major==24?0x7FE1FEU:0x7F87FEU)&(1U<<i));
  assert(memcmp(bytes,selected?p.patched:p.original,p.size)==0);
 }
 const auto oldWrites=writes,oldProtects=protects;call();assert(writes==oldWrites&&protects==oldProtects&&allocations==1);
 assert(properties.at("NRedVCNUserD07")==1);if(fair)assert(properties.at("NRedDRMVideoState")==3);
 cases++;
}
int main(int argc,char** argv){
 fvrcEnabled=true;
 const unsigned group=argc>2?std::stoul(argv[2]):0;
 {
  TransactionBuffer transaction;assert(transaction.state);
  const auto& input=transaction.state->input;
  assert(input.reads==0&&input.bytes==0&&input.candidates==0&&!input.failed&&!input.tableRead);
  assert(input.cache.address==0&&input.cache.size==0&&!input.contextReader&&!input.readerContext);
  for(const auto& page:transaction.state->pages)assert(!page.writable&&!page.maximumPending);
  GuardBuffer guard;assert(guard.plan&&guard.plan->count==0&&guard.plan->page==0&&!guard.plan->installed);
  DynamicBuffer dynamic(true);assert(dynamic.plan&&dynamic.plan->reads==0);
  for(const auto& image:dynamic.plan->images)assert(image.address==0&&image.segmentCount==0);
 }
 for(unsigned id=0;id<=0xffff;id++){
