  assert(p.routes==2*int(os==24||os==25));if(os==24||os==25)assert(properties.at("NRedVCNVPFLifecycle")==1);if(os==23)assert(properties.at("NRedVCNUserSafetyProfileMissing")==1);cases++;
 }
 for(unsigned id:{0x15d8U,0x15ddU,0x6863U,0U,0xffff1638U}){
  Version::majorValue=major;NRed::device=id;KernelPatcher p;UserVideoDecode::init(p);assert(p.solves==0&&p.routes==0);cases++;
 }
 NRed::device=0x1638;Version::majorValue=major;
 {flag=false;KernelPatcher p;UserVideoDecode::init(p);assert(p.solves==0&&p.routes==0);flag=true;cases++;}
 {KernelPatcher p;p.missing=true;UserVideoDecode::init(p);assert(!devicePatches&&p.routes==0);cases++;}
 IOLockFree(guardLock);guardLock=nullptr;failLock=true;
 {KernelPatcher p;UserVideoDecode::init(p);assert(!devicePatches&&p.routes==0);cases++;}failLock=false;
 {KernelPatcher p;p.routeOK=false;UserVideoDecode::init(p);assert(!guardLock&&!devicePatches);cases++;}
 for(unsigned id:{0x15e7U,0x1636U,0x1638U,0x164cU}){
  if(argc>=2&&id!=std::stoul(argv[1],nullptr,16))continue;
  if(group==0){
  setup(id);processName="VTEncoderXPCService";accepted(false);assert(properties.at("NRedVCNGuardedEncoderPID")==217);
