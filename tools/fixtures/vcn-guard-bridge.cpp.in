static unsigned failNewAt=0,newCalls=0;
template<class T> static T* allocateObjects(size_t count){
 if(++newCalls==failNewAt)return nullptr;
 // IONew 不调用构造函数；非零填充使测试不依赖分配器碰巧返回零页。
 auto* value=static_cast<T*>(std::malloc(sizeof(T)*count));
 if(value)memset(value,0x01,sizeof(T)*count);
 return value;
}
#undef IODelete
#define IODelete(P,T,N) std::free(P)
#undef IONew
#define IONew(T,N) allocateObjects<T>(N)
using vm_address_t=uint64_t;
constexpr int VM_FLAGS_ANYWHERE=1;
using IOLock=std::mutex;
static bool failLock=false;
static IOLock* IOLockAlloc(){return failLock?nullptr:new IOLock;}
static void IOLockFree(IOLock* p){delete p;}
static void IOLockLock(IOLock* p){p->lock();}
static void IOLockUnlock(IOLock* p){p->unlock();}
constexpr int THREAD_UNINT=0;
static std::condition_variable_any gateChanged;
static int IOLockSleep(IOLock* p,void*,int){std::unique_lock held(*p,std::adopt_lock);gateChanged.wait(held);held.release();return 0;}
static void IOLockWakeup(IOLock*,void*,bool){gateChanged.notify_all();}
