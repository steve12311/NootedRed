    auto& p=i<D::PatchCount?nativePlan.patches[i]:safetyPlan.patches[i-D::PatchCount];
    for(auto a=(base+p.offset)&~uint64_t(4095);a<=((base+p.offset+p.size-1)&~uint64_t(4095));a+=4096)selectedPages.insert(a);
   }
   const unsigned sourcePages=selectedPages.size(),entries=(fair?18:D::PatchCount)+safetyPlan.count;
   if(group==start)for(unsigned entry=1;entry<=entries+1;entry++){
    setup(id);if(fair)clientEntitlement=kOSBooleanTrue;auto before=blocks;failWrite=entry;call();unchanged(before);noApplied();assert(deallocations==1);cases++;
   }
   if(group==start+1)for(unsigned page=1;page<=sourcePages+2;page++){
